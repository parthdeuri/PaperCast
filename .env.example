# Pick a provider: "gemini" (free, recommended), "groq" (free, faster/smaller
# models), or "anthropic" (no permanent free tier - paid).
PODCAST_PROVIDER=gemini

# --- Gemini (free tier, no credit card) ---
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Groq (free tier, no credit card) ---
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Anthropic (paid, no permanent free tier) ---
ANTHROPIC_API_KEY=

# --- Local model via an OpenAI-compatible server (Ollama, vLLM) ---
# Set PODCAST_PROVIDER=openai_compatible. Under docker-compose the base URL
# defaults to http://host.docker.internal:11434/v1 (Ollama on the host).
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# Optional overrides:
# PODCAST_MODEL=gemini-3.5-flash-lite   # default for gemini; see src/config.py for others
# PODCAST_MOCK_MODE=1   # forces mock mode even if a key is set
